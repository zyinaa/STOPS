+def _extract_per_item_outcomes(results: list[dict]) -> dict[str, dict]:
+    """Extract per-item paired outcomes from a rollout results list.
+
+    Returns a dict mapping item_id -> {hard, soft, predicted_answer, gold_answers}.
+    Used for paired statistical analysis (McNemar, p_TP, p_FP estimation).
+    """
+    per_item = {}
+    for r in results:
+        item_id = str(r.get("id", ""))
+        if not item_id:
+            continue
+        per_item[item_id] = {
+            "hard": float(r.get("hard", 0)),
+            "soft": float(r.get("soft", 0.0)),
+            "predicted_answer": r.get("predicted_answer", ""),
+            "gold_answers": r.get("gold_answers", []),
+            "fail_reason": r.get("fail_reason", ""),
+        }
+    return per_item
+
